-    signals.push({
-      timestamp: new Date().toISOString(),
-      epic,
-      name: instrument.name,
-      type: "breakout_above",
-      message: `${instrument.name} broke above ${instrument.breakoutAbove} (mid: ${latest.mid})`,
-      bid: latest.bid,
-      offer: latest.offer,
-      mid: latest.mid,
-    });
-  }
-
-  if (instrument.breakoutBelow != null && latest.mid < instrument.breakoutBelow) {
