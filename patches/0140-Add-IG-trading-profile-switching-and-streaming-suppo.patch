+  if (!newProfile || (currentIgConfig && currentIgConfig.activeProfile === newProfile)) return;
+
+  if (newProfile === 'live') {
+    if (!confirm('Switch to LIVE trading? Real money will be at risk.')) return;
+  }
+
+  apiFetch('/api/ig/config', {
