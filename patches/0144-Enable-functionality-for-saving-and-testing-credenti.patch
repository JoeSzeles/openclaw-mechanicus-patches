From 4bf647f20f51146a349645f9711184712baee8d3 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Sat, 28 Feb 2026 11:55:24 +0000
Subject: [PATCH 144/244] Enable functionality for saving and testing
 credentials across different environments

Update HTML to use button IDs instead of inline onclick handlers and add corresponding event listeners in JavaScript to support the save and test functionality for demo and live environments.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: d517740c-e24b-4d05-80ee-1f4fb8ac02ea
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 3a6dff6f-c1a2-49fb-9e6b-e724a89424f1
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/d517740c-e24b-4d05-80ee-1f4fb8ac02ea/SoYG0KA
Replit-Helium-Checkpoint-Created: true
---
 ui/public/model-config.html | 8 ++++----
 ui/public/model-config.js   | 5 +++++
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/ui/public/model-config.html b/ui/public/model-config.html
index bd852ce11..7a584dc1f 100644
--- a/ui/public/model-config.html
+++ b/ui/public/model-config.html
@@ -143,8 +143,8 @@ tr:hover{background:#1c2128}
         <div class="form-group"><label>Base URL</label><input type="text" id="demo-baseUrl" value="https://demo-api.ig.com/gateway/deal" readonly></div>
       </div>
       <div class="btn-row">
-        <button class="btn btn-primary" onclick="saveProfile('demo')">Save Demo Credentials</button>
-        <button class="btn btn-secondary" onclick="testConnection()">Test Connection</button>
+        <button class="btn btn-primary" id="btnSaveDemo">Save Demo Credentials</button>
+        <button class="btn btn-secondary" id="btnTestDemo">Test Connection</button>
       </div>
     </div>
   </div>
@@ -168,8 +168,8 @@ tr:hover{background:#1c2128}
         <div class="form-group"><label>Base URL</label><input type="text" id="live-baseUrl" value="https://api.ig.com/gateway/deal" readonly></div>
       </div>
       <div class="btn-row">
-        <button class="btn btn-primary" onclick="saveProfile('live')">Save Live Credentials</button>
-        <button class="btn btn-secondary" onclick="testConnection()">Test Connection</button>
+        <button class="btn btn-primary" id="btnSaveLive">Save Live Credentials</button>
+        <button class="btn btn-secondary" id="btnTestLive">Test Connection</button>
       </div>
     </div>
   </div>
diff --git a/ui/public/model-config.js b/ui/public/model-config.js
index 99086783f..7c656c5e4 100644
--- a/ui/public/model-config.js
+++ b/ui/public/model-config.js
@@ -282,5 +282,10 @@ function testConnection() {
   });
 }
 
+document.getElementById('btnSaveDemo').addEventListener('click', function() { saveProfile('demo'); });
+document.getElementById('btnTestDemo').addEventListener('click', function() { testConnection(); });
+document.getElementById('btnSaveLive').addEventListener('click', function() { saveProfile('live'); });
+document.getElementById('btnTestLive').addEventListener('click', function() { testConnection(); });
+
 loadConfig();
 loadIgConfig();
-- 
