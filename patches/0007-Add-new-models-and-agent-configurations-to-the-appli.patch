From 4477b61d060653f998ebaa4fe92cdbf5c2e5fd6d Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Mon, 23 Feb 2026 06:43:34 +0000
Subject: [PATCH 007/244] Add new models and agent configurations to the
 application

Update openclaw.json to include OpenAI GPT-4o and GPT-4o Mini models, define default agent settings, and configure authentication profiles. Modify start.sh to copy the updated configuration file before launching the gateway.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: ec0db605-e461-43a1-8678-7de14faee181
Replit-Commit-Checkpoint-Type: intermediate_checkpoint
Replit-Commit-Event-Id: dfd19b87-0347-426c-aea7-8f4cac324368
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/ec0db605-e461-43a1-8678-7de14faee181/CtLdR4X
Replit-Helium-Checkpoint-Created: true
---
 openclaw.json | 44 +++++++++++++++++++++++++++++++++++++++++++-
 start.sh      |  2 ++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/openclaw.json b/openclaw.json
index 9e925007d..b28d3bbf4 100644
--- a/openclaw.json
+++ b/openclaw.json
@@ -8,11 +8,53 @@
     }
   },
   "models": {
+    "mode": "merge",
     "providers": {
       "openai": {
         "baseUrl": "${AI_INTEGRATIONS_OPENAI_BASE_URL}",
         "apiKey": "${AI_INTEGRATIONS_OPENAI_API_KEY}",
-        "models": []
+        "api": "openai-completions",
+        "models": [
+          {
+            "id": "gpt-4o",
+            "name": "GPT-4o",
+            "reasoning": false,
+            "input": ["text", "image"],
+            "contextWindow": 128000,
+            "maxTokens": 16384
+          },
+          {
+            "id": "gpt-4o-mini",
+            "name": "GPT-4o Mini",
+            "reasoning": false,
+            "input": ["text", "image"],
+            "contextWindow": 128000,
+            "maxTokens": 16384
+          }
+        ]
+      }
+    }
+  },
+  "agents": {
+    "defaults": {
+      "model": {
+        "primary": "openai/gpt-4o"
+      },
+      "models": {
+        "openai/gpt-4o": {
+          "alias": "GPT-4o"
+        },
+        "openai/gpt-4o-mini": {
+          "alias": "GPT-4o Mini"
+        }
+      }
+    }
+  },
+  "auth": {
+    "profiles": {
+      "openai:default": {
+        "provider": "openai",
+        "mode": "api_key"
       }
     }
   }
diff --git a/start.sh b/start.sh
index 560fdbbf6..cccef39f4 100755
--- a/start.sh
+++ b/start.sh
@@ -9,4 +9,6 @@ JSEOF
 export OPENAI_API_KEY="${AI_INTEGRATIONS_OPENAI_API_KEY}"
 export OPENAI_BASE_URL="${AI_INTEGRATIONS_OPENAI_BASE_URL}"
 
+cp /home/runner/workspace/openclaw.json /home/runner/.openclaw/openclaw.json 2>/dev/null || true
+
 exec node dist/entry.js gateway --bind lan --port 5000 --allow-unconfigured
-- 
2.40.0.windows.1

