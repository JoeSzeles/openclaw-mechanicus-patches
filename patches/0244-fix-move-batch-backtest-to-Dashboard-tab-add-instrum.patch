+var _batchBtSearchTimeout = null;
+function batchBtSearchInstrument(q) {
+  if (_batchBtSearchTimeout) clearTimeout(_batchBtSearchTimeout);
+  var resultsEl = document.getElementById('batchBtSearchResults');
+  q = (q || '').trim();
+  if (q.length < 2) { resultsEl.style.display = 'none'; return; }
+  _batchBtSearchTimeout = setTimeout(function() {
+    apiFetch('/api/ig/markets?q=' + encodeURIComponent(q)).then(function(data) {
+      if (!data || !data.markets || data.markets.length === 0) {
+        resultsEl.innerHTML = '<div style="padding:8px;color:#8b949e">No results</div>';
+        resultsEl.style.display = '';
+        return;
+      }
+      var html = '';
+      for (var i = 0; i < Math.min(data.markets.length, 10); i++) {
+        var m = data.markets[i];
+        html += '<div style="padding:6px 8px;cursor:pointer;border-bottom:1px solid #21262d" onmouseenter="this.style.background=\'rgba(88,166,255,0.08)\'" onmouseleave="this.style.background=\'\'" onclick="batchBtSelectInstrument(\'' + m.epic + '\',\'' + (m.instrumentName || '').replace(/'/g, "\\'") + '\')">' +
+          '<span style="font-weight:600">' + (m.instrumentName || m.epic) + '</span> ' +
+          '<span style="color:#8b949e;font-size:10px">' + m.epic + '</span></div>';
+      }
+      resultsEl.innerHTML = html;
+      resultsEl.style.display = '';
+    });
+  }, 400);
+}
+
+function batchBtSelectInstrument(epic, name) {
+  document.getElementById('batchBtInstrument').value = epic;
+  document.getElementById('batchBtSearchResults').style.display = 'none';
+}
+
+function renderBatchVarsPanel() {
+  var panel = document.getElementById('batchBtVarsPanel');
+  if (!panel) return;
+  var checkedBoxes = document.getElementById('batchBtStratChecks').querySelectorAll('input[type=checkbox]:checked');
+  var selectedTypes = [];
+  for (var i = 0; i < checkedBoxes.length; i++) selectedTypes.push(checkedBoxes[i].value);
+  if (selectedTypes.length === 0) {
+    panel.innerHTML = '<p class="empty" style="margin:0">Select strategy types above to see their configurable variables.</p>';
+    return;
+  }
+  var html = '';
+  for (var t = 0; t < selectedTypes.length; t++) {
+    var sType = selectedTypes[t];
+    var schema = (typeof strategySchemas !== 'undefined' && strategySchemas[sType]) ? strategySchemas[sType].configSchema : null;
+    if (!schema || schema.length === 0) continue;
+    html += '<div style="margin-bottom:8px;border-bottom:1px solid #21262d;padding-bottom:8px">';
+    html += '<div style="font-weight:600;color:#58a6ff;margin-bottom:4px;font-size:11px">' + sType + '</div>';
+    html += '<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px">';
+    for (var p = 0; p < schema.length; p++) {
+      var param = schema[p];
+      var fieldId = 'batchVar_' + sType + '_' + param.key;
+      if (param.type === 'boolean') {
+        html += '<div><label style="color:#8b949e;font-size:10px">' + (param.label || param.key) + '</label>';
+        html += '<select class="edit-input" id="' + fieldId + '" style="width:100%;padding:2px 4px;font-size:10px">';
+        html += '<option value="">default</option><option value="true">true</option><option value="false">false</option>';
+        html += '</select></div>';
+      } else {
+        html += '<div><label style="color:#8b949e;font-size:10px">' + (param.label || param.key) + '</label>';
+        html += '<input class="edit-input" id="' + fieldId + '" type="number" step="any" placeholder="' + (param.default != null ? param.default : '') + '" style="width:100%;padding:2px 4px;font-size:10px"></div>';
+      }
+    }
+    html += '</div></div>';
+  }
+  if (!html) html = '<p class="empty" style="margin:0">Selected strategies have no configurable variables.</p>';
+  panel.innerHTML = html;
+}
+
+function collectBatchVarsForType(sType) {
+  var config = {};
+  var schema = (typeof strategySchemas !== 'undefined' && strategySchemas[sType]) ? strategySchemas[sType].configSchema : null;
+  if (!schema) return config;
+  for (var p = 0; p < schema.length; p++) {
+    var param = schema[p];
+    var el = document.getElementById('batchVar_' + sType + '_' + param.key);
+    if (!el) continue;
+    var val = el.value;
+    if (val === '' || val === null || val === undefined) continue;
+    if (param.type === 'boolean') {
+      config[param.key] = val === 'true';
+    } else {
+      config[param.key] = parseFloat(val);
+    }
+  }
+  return config;
 }
 
