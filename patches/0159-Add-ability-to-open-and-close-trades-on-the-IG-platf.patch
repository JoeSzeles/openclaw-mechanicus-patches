+      console.log(`[ig-trade] Closing ${closeBody.direction} ${closeBody.size} dealId=${closeBody.dealId}`);
+      const r = await igRequest("POST", "/positions/otc", { ...igHeaders(session), "_method": "DELETE", Version: "1" }, JSON.stringify(closeBody));
+      igCacheInvalidate();
+      if (r.status !== 200) {
