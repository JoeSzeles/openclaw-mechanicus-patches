From 7f0d4aabb0fee4c36fd33a2455c2a4ebc217e0c9 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Mon, 23 Feb 2026 14:18:55 +0000
Subject: [PATCH 038/244] Improve caching for JavaScript and CSS files

Add cache-busting headers to prevent stale JavaScript and CSS files from being served.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: ec0db605-e461-43a1-8678-7de14faee181
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: ad2d249c-f9c1-470f-9a78-7940a9e84ca2
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/ec0db605-e461-43a1-8678-7de14faee181/Q4aJP8o
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index 469fa1c4e..d21e67aff 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -380,8 +380,15 @@ function proxyReq(req, res) {
     method: req.method,
     headers: { ...req.headers, host: "127.0.0.1:" + GATEWAY_PORT },
   };
+  const noCache = /\/(worker-chat|nav-inject|token-init|workers)\.(js|css|html)/.test(req.url);
   const p = http.request(opts, (pr) => {
-    res.writeHead(pr.statusCode, pr.headers);
+    const headers = { ...pr.headers };
+    if (noCache) {
+      headers["cache-control"] = "no-cache, no-store, must-revalidate";
+      headers["pragma"] = "no-cache";
+      headers["expires"] = "0";
+    }
+    res.writeHead(pr.statusCode, headers);
     pr.pipe(res);
   });
   p.on("error", (err) => {
