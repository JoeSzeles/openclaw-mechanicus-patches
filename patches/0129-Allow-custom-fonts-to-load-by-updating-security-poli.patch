From 6883bbcfe199f0e479a96e2eefa7d07cb88391f9 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Sat, 28 Feb 2026 08:12:50 +0000
Subject: [PATCH 129/244] Allow custom fonts to load by updating security
 policy

Update Content Security Policy to allow Google Fonts and Gstatic domains for style and font sources.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: d517740c-e24b-4d05-80ee-1f4fb8ac02ea
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 1bee9e64-8abe-4849-9d09-a2973181539a
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/d517740c-e24b-4d05-80ee-1f4fb8ac02ea/vkA0lRF
Replit-Helium-Checkpoint-Created: true
---
 src/gateway/control-ui-csp.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/gateway/control-ui-csp.ts b/src/gateway/control-ui-csp.ts
index 31cd98bd6..1f475336c 100644
--- a/src/gateway/control-ui-csp.ts
+++ b/src/gateway/control-ui-csp.ts
@@ -7,9 +7,9 @@ export function buildControlUiCspHeader(): string {
     "object-src 'none'",
     "frame-ancestors 'none'",
     "script-src 'self'",
-    "style-src 'self' 'unsafe-inline'",
+    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
     "img-src 'self' data: https:",
-    "font-src 'self'",
+    "font-src 'self' https://fonts.gstatic.com",
     "connect-src 'self' ws: wss:",
   ].join("; ");
 }
