Replit-Helium-Checkpoint-Created: true
---
 .npmrc                            | 2 ++
 .replit                           | 3 ++-
 dist/control-ui/model-config.html | 6 +++---
 dist/control-ui/processes.html    | 6 +++---
 dist/control-ui/workers.html      | 6 +++---
 5 files changed, 13 insertions(+), 10 deletions(-)

diff --git a/.npmrc b/.npmrc
index f0c783cb6..b522eee31 100644
--- a/.npmrc
+++ b/.npmrc
@@ -1 +1,3 @@
 allow-build-scripts=@whiskeysockets/baileys,sharp,esbuild,protobufjs,fs-ext,node-pty,@lydell/node-pty,@matrix-org/matrix-sdk-crypto-nodejs
+prefer-offline=true
+optional=false
diff --git a/.replit b/.replit
index fa4f53e3a..06a07bec1 100644
--- a/.replit
+++ b/.replit
@@ -57,4 +57,5 @@ externalPort = 3002
 [deployment]
 deploymentTarget = "vm"
 run = ["bash", "-c", "cd /home/runner/workspace && COREPACK_ENABLE_STRICT=0 bash start.sh"]
-build = ["bash", "-c", "cd /home/runner/workspace && npm install --omit=dev --prefer-offline --no-audit --no-fund 2>&1 | tail -5 && echo build-ok"]
+build = ["bash", "-c", "echo 'skipping build - start.sh handles deps'"]
+publicDir = "dist"
diff --git a/dist/control-ui/model-config.html b/dist/control-ui/model-config.html
index 9395a006e..95917c9aa 100644
