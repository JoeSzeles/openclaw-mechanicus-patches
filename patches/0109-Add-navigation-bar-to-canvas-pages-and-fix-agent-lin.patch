From 5ea430a67e02c8362cb9944c5790b042bd488185 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Sat, 28 Feb 2026 03:54:17 +0000
Subject: [PATCH 109/244] Add navigation bar to canvas pages and fix agent link
 generation

Injects the navigation bar script into canvas HTML pages and improves agent instructions to prevent incorrect link generation and hallucinated file deployments.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: 9b6db5b8-bb27-4a35-8d77-7730eb3a7059
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 2616ced1-b03d-4a6a-b6c5-f78eeb4135a6
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/9b6db5b8-bb27-4a35-8d77-7730eb3a7059/idaQsjn
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index 9f0270cb2..0aadb26d8 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -1028,6 +1028,16 @@ function proxyReq(req, res, retries = 3) {
   req.pipe(p);
 }
 
+const NAV_INJECT_TAG = '<script src="/nav-inject.js"></script>';
+
+function injectNavIntoHtml(buf) {
+  const html = buf.toString("utf-8");
+  if (html.includes("nav-inject.js")) return buf;
+  const idx = html.indexOf("</body>");
+  if (idx === -1) return Buffer.from(html + NAV_INJECT_TAG);
+  return Buffer.from(html.slice(0, idx) + NAV_INJECT_TAG + html.slice(idx));
+}
+
 function serveCanvas(req, res) {
   const url = new URL(req.url, "http://localhost");
   const prefix = "/__openclaw__/canvas/";
@@ -1044,10 +1054,10 @@ function serveCanvas(req, res) {
     if (stat.isDirectory()) {
       const idx = path.join(filePath, "index.html");
       if (fs.existsSync(idx)) {
-        const data = fs.readFileSync(idx);
-        const ext = ".html";
+        const raw = fs.readFileSync(idx);
+        const data = injectNavIntoHtml(raw);
         res.writeHead(200, {
-          "Content-Type": MIME_TYPES[ext] || "application/octet-stream",
+          "Content-Type": "text/html; charset=utf-8",
           "Content-Length": data.length,
           "Access-Control-Allow-Origin": "*",
         });
@@ -1055,8 +1065,10 @@ function serveCanvas(req, res) {
         return true;
       }
     }
-    const data = fs.readFileSync(filePath);
+    const raw = fs.readFileSync(filePath);
     const ext = path.extname(filePath).toLowerCase();
+    const isHtml = ext === ".html" || ext === ".htm";
+    const data = isHtml ? injectNavIntoHtml(raw) : raw;
     res.writeHead(200, {
       "Content-Type": MIME_TYPES[ext] || "application/octet-stream",
       "Content-Length": data.length,
-- 
