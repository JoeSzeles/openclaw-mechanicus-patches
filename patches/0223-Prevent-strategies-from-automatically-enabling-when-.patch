From c8415442052a6840f5cd1a0efc813684e24fb376 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Mon, 2 Mar 2026 05:29:37 +0000
Subject: [PATCH 223/244] Prevent strategies from automatically enabling when
 templates are selected

Add cache-busting headers to canvas HTML files to ensure users always see the latest dashboard version.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: 906b397c-0d51-4c51-938d-028fd77f33b5
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: a68bc800-e9f9-4914-b1c4-d8db70980edf
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/906b397c-0d51-4c51-938d-028fd77f33b5/empGbZf
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index 2d94d78dc..e4f530569 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -3202,6 +3202,9 @@ function serveCanvas(req, res) {
           "Content-Type": "text/html; charset=utf-8",
           "Content-Length": data.length,
           "Access-Control-Allow-Origin": "*",
+          "Cache-Control": "no-cache, no-store, must-revalidate",
+          "Pragma": "no-cache",
+          "Expires": "0",
         });
         res.end(data);
         return true;
@@ -3211,11 +3214,17 @@ function serveCanvas(req, res) {
     const ext = path.extname(filePath).toLowerCase();
     const isHtml = ext === ".html" || ext === ".htm";
     const data = isHtml ? injectNavIntoHtml(raw, filePath) : raw;
-    res.writeHead(200, {
+    const headers = {
       "Content-Type": MIME_TYPES[ext] || "application/octet-stream",
       "Content-Length": data.length,
       "Access-Control-Allow-Origin": "*",
-    });
+    };
+    if (isHtml) {
+      headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
+      headers["Pragma"] = "no-cache";
+      headers["Expires"] = "0";
+    }
+    res.writeHead(200, headers);
     res.end(data);
     return true;
   } catch {
