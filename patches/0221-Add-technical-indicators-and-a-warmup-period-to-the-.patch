+var scalperPanelOpen = true;
+function toggleScalperPanel() {
+  scalperPanelOpen = !scalperPanelOpen;
+  document.getElementById('scalperPanel').style.display = scalperPanelOpen ? '' : 'none';
+  document.getElementById('scalperToggleIcon').innerHTML = scalperPanelOpen ? '&#9660;' : '&#9654;';
+}
+
+async function loadScalperStatus() {
+  var section = document.getElementById('scalperSection');
+  var data = await apiFetch('/api/ig/scalper/status');
+  if (!data) { section.style.display = 'none'; return; }
+  section.style.display = '';
+  loadScalperTemplateDropdown();
+
+  var badge = document.getElementById('scalperBadge');
+  if (data.running) {
+    badge.className = 'badge badge-on';
+    badge.textContent = 'RUNNING (' + data.openPositions + ' open)';
+  } else if (data.drawdownTripped) {
+    badge.className = 'badge badge-alert';
+    badge.textContent = 'DRAWDOWN LIMIT';
+  } else {
+    badge.className = 'badge badge-off';
+    badge.textContent = data.enabled ? 'ENABLED' : 'STOPPED';
+  }
+
+  var pnlEl = document.getElementById('scalperPnl');
+  pnlEl.textContent = (data.realizedPnl >= 0 ? '+' : '') + fmtNum(data.realizedPnl);
+  pnlEl.className = 'value ' + (data.realizedPnl >= 0 ? 'pos' : 'neg');
+  document.getElementById('scalperTrades').textContent = data.tradeCount + ' (' + data.winCount + 'W/' + data.lossCount + 'L)';
+  document.getElementById('scalperWinRate').textContent = data.winRate + '%';
+  document.getElementById('scalperBudget').textContent = fmtNum(data.budget);
+  document.getElementById('scalperMaxDD').textContent = fmtNum(data.maxDrawdown);
+  document.getElementById('scalperMaxMargin').textContent = data.maxMarginPct;
+  document.getElementById('scalperBE').textContent = data.breakEvenBuffer;
+  document.getElementById('scalperCooldown').textContent = (data.cooldownMs / 1000).toFixed(0);
+  document.getElementById('scalperTicks').textContent = data.tickWindow;
+  document.getElementById('scalperMinMom').textContent = data.minMomentumPct;
+  document.getElementById('scalperMinSize').textContent = data.minSize || 0.5;
+  document.getElementById('scalperMaxSize').textContent = data.maxSize || 10;
+  document.getElementById('scalperProfitTarget').textContent = data.profitTarget || 0;
+  document.getElementById('scalperTrailingStop').textContent = data.trailingStop || 0;
+  document.getElementById('scalperWarmup').textContent = Math.round((data.warmupMs || 60000) / 1000);
+  var warmupRemain = data.warmupRemaining || 0;
+  document.getElementById('scalperWarmupStatus').textContent = warmupRemain > 0 ? '(observing... ' + Math.ceil(warmupRemain / 1000) + 's left)' : '';
+  var ind = data.indicators || {};
+  var indParts = [];
+  if (ind.rsi && ind.rsi.enabled) indParts.push('RSI(' + (ind.rsi.period || 14) + ', OB:' + (ind.rsi.overbought || 70) + ', OS:' + (ind.rsi.oversold || 30) + ')');
+  if (ind.ema && ind.ema.enabled) indParts.push('EMA(' + (ind.ema.shortPeriod || 9) + '/' + (ind.ema.longPeriod || 21) + ')');
+  if (ind.macd && ind.macd.enabled) indParts.push('MACD(' + (ind.macd.fast || 12) + '/' + (ind.macd.slow || 26) + '/' + (ind.macd.signal || 9) + ')');
+  document.getElementById('scalperIndList').textContent = indParts.length ? indParts.join(' | ') : 'none';
+
+  var strategies = data.strategies || [];
+  var html = '<tr><th>Name</th><th>Instrument</th><th>Dir</th><th>Size</th><th>Stop</th><th>Limit</th><th>Min Mom%</th><th>Status</th><th>Linked</th><th>Actions</th></tr>';
+  if (strategies.length === 0) {
+    html += '<tr><td colspan="10" class="empty">No scalper strategies</td></tr>';
+  }
+  for (var i = 0; i < strategies.length; i++) {
+    var s = strategies[i];
+    var toggleClass = s.enabled ? 'btn-sm btn-toggle' : 'btn-sm btn-toggle off';
+    html += '<tr>';
+    html += '<td style="font-weight:600">' + (s.name || s.instrument) + '</td>';
+    html += '<td style="font-size:11px;color:#8b949e">' + s.instrument + '</td>';
+    html += '<td><span class="badge ' + (s.direction === 'BUY' ? 'badge-on' : s.direction === 'SELL' ? 'badge-alert' : 'badge-spike') + '">' + s.direction + '</span></td>';
+    html += '<td>' + (s.size || '-') + '</td>';
+    html += '<td>' + (s.stopDistance || 'auto') + '</td>';
+    html += '<td>' + (s.limitDistance || 'auto') + '</td>';
+    html += '<td>' + (s.minMomentumPct || '-') + '</td>';
+    html += '<td><button class="' + toggleClass + '" onclick="scalperToggle(' + i + ')">' + (s.enabled ? 'ON' : 'OFF') + '</button></td>';
+    html += '<td>' + (s.dealId ? '<span style="font-size:10px;color:#8b949e">' + s.dealId.substring(0, 10) + '...</span>' : '-') + '</td>';
+    html += '<td><button class="btn-sm btn-danger" onclick="scalperDeleteStrat(' + i + ')">Del</button></td>';
+    html += '</tr>';
+  }
+  document.getElementById('scalperStrategies').innerHTML = html;
+
+  var trades = data.recentTrades || [];
+  var thtml = '<tr><th>Time</th><th>Type</th><th>Instrument</th><th>Dir</th><th>Entry</th><th>Exit</th><th>P&L</th></tr>';
+  if (trades.length === 0) {
+    thtml += '<tr><td colspan="7" class="empty">No trades yet</td></tr>';
+  }
+  for (var j = 0; j < trades.length; j++) {
+    var t = trades[j];
+    var timeStr = t.timestamp ? new Date(t.timestamp).toLocaleTimeString('en-GB', {hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '-';
+    thtml += '<tr>';
+    thtml += '<td style="font-size:10px">' + timeStr + '</td>';
+    thtml += '<td><span class="badge ' + (t.type === 'open' ? 'badge-spike' : 'badge-snap') + '">' + t.type.toUpperCase() + '</span></td>';
+    thtml += '<td>' + epicShortName(t.epic) + '</td>';
+    thtml += '<td><span class="badge ' + (t.direction === 'BUY' ? 'badge-on' : 'badge-alert') + '">' + (t.direction || '-') + '</span></td>';
+    thtml += '<td>' + fmtNum(t.entry, 2) + '</td>';
+    thtml += '<td>' + (t.exit ? fmtNum(t.exit, 2) : '-') + '</td>';
+    thtml += '<td class="' + (t.pnl != null ? (t.pnl >= 0 ? 'pos' : 'neg') : '') + '">' + (t.pnl != null ? (t.pnl >= 0 ? '+' : '') + fmtNum(t.pnl) : '-') + '</td>';
+    thtml += '</tr>';
+  }
+  document.getElementById('scalperTradeLog').innerHTML = thtml;
+}
+
+async function scalperStart() {
+  var r = await apiPost('/api/ig/scalper/start', {});
+  if (r && r.ok) showToast('Scalper started', true);
+  else showToast('Failed to start scalper', false);
+  loadScalperStatus();
+}
+
+async function scalperStop() {
+  var r = await apiPost('/api/ig/scalper/stop', {});
+  if (r && r.ok) showToast('Scalper stopped', true);
+  else showToast('Failed to stop scalper', false);
+  loadScalperStatus();
+}
+
+async function scalperReset() {
+  if (!confirm('Reset all scalper stats and trade history?')) return;
+  var r = await apiPost('/api/ig/scalper/reset', {});
+  if (r && r.ok) showToast('Stats reset', true);
+  loadScalperStatus();
+}
+
+async function scalperToggle(idx) {
+  var r = await apiPost('/api/ig/scalper/strategies/' + idx + '/toggle', {});
+  if (r && r.ok) showToast('Strategy ' + (r.enabled ? 'enabled' : 'disabled'), true);
+  loadScalperStatus();
+}
+
+async function scalperDeleteStrat(idx) {
+  if (!confirm('Delete this scalper strategy?')) return;
+  var opts = { method: 'DELETE', headers: { 'Accept': 'application/json' } };
+  if (TOKEN) opts.headers['Authorization'] = 'Bearer ' + TOKEN;
+  var res = await fetch('/api/ig/scalper/strategies/' + idx, opts);
+  var data = await res.json();
+  if (data.ok) showToast('Strategy deleted', true);
+  else showToast('Failed', false);
+  loadScalperStatus();
+}
+
+function editScalperSettings() {
+  document.getElementById('scalperSettingsEdit').style.display = '';
+  document.getElementById('seditBudget').value = document.getElementById('scalperBudget').textContent;
+  document.getElementById('seditMaxDD').value = document.getElementById('scalperMaxDD').textContent;
+  document.getElementById('seditMaxMargin').value = document.getElementById('scalperMaxMargin').textContent;
+  document.getElementById('seditBE').value = document.getElementById('scalperBE').textContent;
+  document.getElementById('seditCooldown').value = parseFloat(document.getElementById('scalperCooldown').textContent) * 1000;
+  document.getElementById('seditTicks').value = document.getElementById('scalperTicks').textContent;
+  document.getElementById('seditMinMom').value = document.getElementById('scalperMinMom').textContent;
+  document.getElementById('seditMinSize').value = document.getElementById('scalperMinSize').textContent;
+  document.getElementById('seditMaxSize').value = document.getElementById('scalperMaxSize').textContent;
+  document.getElementById('seditProfitTarget').value = document.getElementById('scalperProfitTarget').textContent;
+  document.getElementById('seditTrailingStop').value = document.getElementById('scalperTrailingStop').textContent;
+  document.getElementById('seditWarmup').value = document.getElementById('scalperWarmup').textContent;
+  apiFetch('/api/ig/scalper/status').then(function(d) {
+    if (!d) return;
+    document.getElementById('seditMaxPos').value = d.maxOpenPositions || 2;
+    var ind = d.indicators || {};
+    var rsi = ind.rsi || {};
+    document.getElementById('seditRsiOn').checked = !!rsi.enabled;
+    document.getElementById('seditRsiPeriod').value = rsi.period || 14;
+    document.getElementById('seditRsiOB').value = rsi.overbought || 70;
+    document.getElementById('seditRsiOS').value = rsi.oversold || 30;
+    var ema = ind.ema || {};
+    document.getElementById('seditEmaOn').checked = !!ema.enabled;
+    document.getElementById('seditEmaShort').value = ema.shortPeriod || 9;
+    document.getElementById('seditEmaLong').value = ema.longPeriod || 21;
+    var macd = ind.macd || {};
+    document.getElementById('seditMacdOn').checked = !!macd.enabled;
+    document.getElementById('seditMacdFast').value = macd.fast || 12;
+    document.getElementById('seditMacdSlow').value = macd.slow || 26;
+    document.getElementById('seditMacdSignal').value = macd.signal || 9;
+  });
