From 6f468090d41c84801837d93d2574ad077553a207 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Sun, 1 Mar 2026 04:13:51 +0000
Subject: [PATCH 170/244] Speed up deployment by skipping unnecessary package
 installations

Change deployment script to use `npm install --omit=dev --prefer-offline --no-audit --no-fund` to bypass slow workspace package resolution and native module compilation, preventing deployment timeouts.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: d517740c-e24b-4d05-80ee-1f4fb8ac02ea
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 1fcfde3e-bcc2-4fd9-9db5-1d82efc2d2f6
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/d517740c-e24b-4d05-80ee-1f4fb8ac02ea/cGjnef9
Replit-Helium-Checkpoint-Created: true
---
 .replit                                   |   2 +-
 attached_assets/jtyjtyj_1772338284497.JPG | Bin 0 -> 59339 bytes
 2 files changed, 1 insertion(+), 1 deletion(-)
 create mode 100644 attached_assets/jtyjtyj_1772338284497.JPG

diff --git a/.replit b/.replit
index ed8370b49..fa4f53e3a 100644
--- a/.replit
+++ b/.replit
@@ -57,4 +57,4 @@ externalPort = 3002
 [deployment]
 deploymentTarget = "vm"
 run = ["bash", "-c", "cd /home/runner/workspace && COREPACK_ENABLE_STRICT=0 bash start.sh"]
-build = ["bash", "-c", "echo pre-built"]
+build = ["bash", "-c", "cd /home/runner/workspace && npm install --omit=dev --prefer-offline --no-audit --no-fund 2>&1 | tail -5 && echo build-ok"]
