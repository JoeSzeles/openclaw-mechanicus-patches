From 2fe153bc9727e137e2b23831ccc249139c5cea77 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Tue, 24 Feb 2026 23:37:52 +0000
Subject: [PATCH 080/244] Add a loading screen while the gateway starts up

Update the proxy to display a loading page with a spinner and auto-refresh while waiting for the gateway to start, and implement retry logic for the gateway connection.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: 9b6db5b8-bb27-4a35-8d77-7730eb3a7059
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 6069e170-fe66-407c-b9fb-037076867905
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/9b6db5b8-bb27-4a35-8d77-7730eb3a7059/emgC5dV
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index 62c1439e3..054468e99 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -806,7 +806,14 @@ async function handleApi(req, res) {
   return false;
 }
 
-function proxyReq(req, res) {
+const LOADING_HTML = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>OpenClaw Cloud</title>
+<meta http-equiv="refresh" content="3">
+<style>body{background:#1a1a2e;color:#e0e0e0;font-family:system-ui;display:flex;justify-content:center;align-items:center;height:100vh;margin:0}
+.c{text-align:center}.s{font-size:48px;animation:spin 1s linear infinite;display:inline-block}
+@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}</style></head>
+<body><div class="c"><div class="s">🦞</div><h2>OpenClaw Gateway Starting...</h2><p>This page will auto-refresh in a few seconds.</p></div></body></html>`;
+
+function proxyReq(req, res, retries = 3) {
   const opts = {
     hostname: "127.0.0.1",
     port: GATEWAY_PORT,
@@ -826,9 +833,17 @@ function proxyReq(req, res) {
     pr.pipe(res);
   });
   p.on("error", (err) => {
-    if (!res.headersSent) {
-      res.writeHead(502, { "Content-Type": "text/plain" });
-      res.end("Bad Gateway - OpenClaw gateway starting...");
+    if (retries > 0 && !res.headersSent) {
+      setTimeout(() => proxyReq(req, res, retries - 1), 2000);
+    } else if (!res.headersSent) {
+      const accept = (req.headers.accept || "");
+      if (accept.includes("text/html")) {
+        res.writeHead(503, { "Content-Type": "text/html" });
+        res.end(LOADING_HTML);
+      } else {
+        res.writeHead(502, { "Content-Type": "text/plain" });
+        res.end("Bad Gateway - OpenClaw gateway starting...");
+      }
     }
   });
   req.pipe(p);
