+  legendItems += `<text x="${legendX + 20}" y="${legendY + 4}" fill="#9ca3af" font-size="10">Predicted</text>`;
+  legendY += 16;
+  
+  // Actual/Real
+  if (realPricePath) {
+    legendItems += `<line x1="${legendX}" y1="${legendY}" x2="${legendX + 15}" y2="${legendY}" stroke="#ef4444" stroke-width="2"/>`;
