+    const now = Math.floor(Date.now() / 1000);
+    const interval = 60;
+    const chartData = equityData.map((val, i) => ({
+      time: now - (equityData.length - i) * interval,
+      value: val
+    }));
+    areaSeries.setData(chartData);
