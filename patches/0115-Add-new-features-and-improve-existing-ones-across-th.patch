+    }
+    
+    // Day 1: Today (real data + updating)
+    const todayDate = new Date(todayMidnight);
+    if (todayOHLC) {
+      allDays.push({
+        date: todayDate.toISOString(),
+        dayName: todayDate.toLocaleDateString('en-US', { weekday: 'short' }),
+        direction: todayOHLC.change >= 0 ? 'bullish' : 'bearish',
