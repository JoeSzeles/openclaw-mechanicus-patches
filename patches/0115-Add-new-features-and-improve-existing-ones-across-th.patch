+// Get trade interval based on timeframe (market speed awareness)
+function getTradeIntervalForTimeframe(tf) {
+  const intervals = {
+    '1s': 3000,    // 3 sec
+    '2s': 5000,    // 5 sec
+    '3s': 6000,    // 6 sec
+    '5s': 10000,   // 10 sec
+    '10s': 15000,  // 15 sec
+    '30s': 30000,  // 30 sec
+    '1m': 60000,   // 1 min
+    '5m': 120000,  // 2 min
+    '15m': 300000, // 5 min
+    '1h': 600000,  // 10 min
+    '4h': 900000,  // 15 min
+    '1d': 1800000  // 30 min
+  };
+  return intervals[tf] || 60000;
+}
