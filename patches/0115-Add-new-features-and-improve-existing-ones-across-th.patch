+    for (let i = 1; i < Math.min(candles.length, 14); i++) {
+      const tr = Math.max(
+        highs[i] - lows[i],
+        Math.abs(highs[i] - prices[i-1]),
+        Math.abs(lows[i] - prices[i-1])
+      );
+      atrSum += tr;
+    }
+    const atr = atrSum / 14;
+    const atrPercent = (atr / currentPrice) * 100;
