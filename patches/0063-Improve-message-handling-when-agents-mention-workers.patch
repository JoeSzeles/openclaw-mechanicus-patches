From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Mon, 23 Feb 2026 17:54:39 +0000
Subject: [PATCH 063/244] Improve message handling when agents mention workers
 in responses

Update ceo-proxy.cjs to correctly extract the full message body following a worker mention, rather than just the first line.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: d785e033-2d00-42a6-8d33-fda89b7733ba
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: ea283145-1fdd-4179-aaff-bb704df18d95
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index f47ee5f64..d1eddd74c 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -88,8 +88,8 @@ function connectGateway() {
               }
               lastAutoDispatch[foundWorker.name] = now;
               const nameEsc = foundWorker.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
-              const lineMatch = text.match(new RegExp("@" + nameEsc + "\\s+(.+)", "i"));
-              const body = lineMatch ? lineMatch[1].trim() : text;
+              const bodyMatch = text.match(new RegExp("@" + nameEsc + "\\s+([\\s\\S]+)", "i"));
+              const body = bodyMatch ? bodyMatch[1].trim() : text;
               console.log("[ceo-proxy] CEO agent @mentioned worker:", foundWorker.name, "- auto-dispatching");
               const task = {
                 id: crypto.randomUUID(),
