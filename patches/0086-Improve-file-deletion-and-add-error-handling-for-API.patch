From 0b01aafc8211acb406fb131e6de4e0470dd9b1e9 Mon Sep 17 00:00:00 2001
From: joebereczki <41107035-joebereczki@users.noreply.replit.com>
Date: Thu, 26 Feb 2026 06:06:22 +0000
Subject: [PATCH 086/244] Improve file deletion and add error handling for API
 endpoints

Adds try-catch blocks to /api/sharedspace/write and /api/sharedspace/mkdir endpoints to gracefully handle invalid JSON. Updates the /api/sharedspace/delete endpoint with enhanced logging and error handling for file deletion operations.

Replit-Commit-Author: Agent
Replit-Commit-Session-Id: 9b6db5b8-bb27-4a35-8d77-7730eb3a7059
Replit-Commit-Checkpoint-Type: full_checkpoint
Replit-Commit-Event-Id: 39162cbc-0eed-499d-86d5-e9a0f7fbf6bf
Replit-Commit-Screenshot-Url: https://storage.googleapis.com/screenshot-production-us-central1/be1a940b-924a-449d-ae02-954c66974b04/9b6db5b8-bb27-4a35-8d77-7730eb3a7059/Vm38qIa
Replit-Helium-Checkpoint-Created: true
---
 ceo-proxy.cjs | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/ceo-proxy.cjs b/ceo-proxy.cjs
index baa6bfaaa..cbfc53647 100644
--- a/ceo-proxy.cjs
+++ b/ceo-proxy.cjs
@@ -727,7 +727,9 @@ async function handleSharedspace(req, res, p) {
   }
 
   if (req.method === "POST" && p === "/api/sharedspace/write") {
-    const body = JSON.parse((await readBody(req)).toString());
+    let body;
+    try { body = JSON.parse((await readBody(req)).toString()); }
+    catch { return json(res, 400, { error: "Invalid JSON body" }); }
     if (!body.path) return json(res, 400, { error: "path is required" });
     const fp = path.normalize(body.path);
     const full = path.resolve(SHAREDSPACE_DIR, fp);
@@ -742,7 +744,9 @@ async function handleSharedspace(req, res, p) {
   }
 
   if (req.method === "POST" && p === "/api/sharedspace/mkdir") {
-    const body = JSON.parse((await readBody(req)).toString());
+    let body;
+    try { body = JSON.parse((await readBody(req)).toString()); }
+    catch { return json(res, 400, { error: "Invalid JSON body" }); }
     if (!body.path) return json(res, 400, { error: "path is required" });
     const fp = path.normalize(body.path);
     const full = path.resolve(SHAREDSPACE_DIR, fp);
@@ -758,9 +762,10 @@ async function handleSharedspace(req, res, p) {
     }
     const fp = path.normalize(decodeURIComponent(sub));
     const full = path.resolve(SHAREDSPACE_DIR, fp);
+    console.log("[ceo-proxy] SharedSpace DELETE sub:", sub, "fp:", fp, "full:", full, "inside:", isInsideDir(full, SHAREDSPACE_DIR));
     if (!isInsideDir(full, SHAREDSPACE_DIR)) return json(res, 403, { error: "Forbidden" });
     try { fs.unlinkSync(full); return json(res, 200, { ok: true }); }
-    catch { return json(res, 404, { error: "File not found" }); }
+    catch (e) { console.log("[ceo-proxy] SharedSpace DELETE error:", e.message); return json(res, 404, { error: "File not found" }); }
   }
 
   return json(res, 404, { error: "Not found" });
