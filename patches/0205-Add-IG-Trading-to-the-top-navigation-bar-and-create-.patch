+  selectedMarketData = data;
+  var snap = data.snapshot || {};
+  var inst = data.instrument || {};
+  var deal = data.dealingRules || {};
+
+  var bid = snap.bid || 0;
+  var offer = snap.offer || 0;
+  var mid = (bid + offer) / 2;
+  var spread = offer - bid;
+  var pctChange = snap.percentageChange || 0;
+  var high = snap.high || 0;
+  var low = snap.low || 0;
+  var status = snap.marketStatus || 'UNKNOWN';
+
+  livePrices[epic] = { bid: bid, offer: offer, mid: mid, marketState: status, percentageChange: pctChange, timestamp: Date.now() };
+  renderWatchlistTabs();
+
+  var hdrEl = document.getElementById('instrumentHeader');
+  hdrEl.style.display = 'flex';
+  hdrEl.innerHTML =
+    '<span class="wl-status ' + (status === 'TRADEABLE' ? 'open' : 'closed') + '" style="width:10px;height:10px"></span>' +
+    '<span style="font-weight:700;font-size:16px">' + (inst.name || epic) + '</span>' +
+    '<span class="inst-price">' + fmtNum(mid, 1) + '</span>' +
+    '<span class="inst-change ' + (pctChange >= 0 ? 'pos' : 'neg') + '">' + (pctChange >= 0 ? '+' : '') + fmtNum(pctChange, 2) + '%</span>' +
+    '<span class="inst-details">H ' + fmtNum(high, 1) + ' L ' + fmtNum(low, 1) + '</span>' +
+    '<span class="badge ' + (status === 'TRADEABLE' ? 'badge-on' : 'badge-off') + '">' + status + '</span>';
