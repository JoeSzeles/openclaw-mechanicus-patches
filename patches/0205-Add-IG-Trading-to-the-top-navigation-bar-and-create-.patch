+  var alerts = await fetchJSON('/__openclaw__/canvas/ig-alerts-snapshot.json');
+  var el = document.getElementById('alerts');
+  if (!alerts || !Array.isArray(alerts) || alerts.length === 0) {
+    el.innerHTML = '<p class="empty">No alerts recorded</p>';
+    return;
+  }
+  var recent = alerts.slice(-25).reverse();
+  var html = '<table><tr><th>Time</th><th>Instrument</th><th>Type</th><th>Message</th><th>Mid</th></tr>';
+  for (var i = 0; i < recent.length; i++) {
+    var a = recent[i];
+    var time = a.timestamp ? new Date(a.timestamp).toLocaleString() : '?';
+    var typeBadge = '<span class="badge ' + badgeType(a.type) + '">' + (a.type || '?') + '</span>';
+    html += '<tr><td style="white-space:nowrap;font-size:12px">' + time + '</td><td>' + (a.name || a.epic) + '</td><td>' + typeBadge + '</td><td style="font-size:12px">' + (a.message || '') + '</td><td>' + (a.mid != null ? a.mid.toFixed(5) : '-') + '</td></tr>';
+  }
+  html += '</table>';
+  el.innerHTML = html;
+}
+
+async function loadBotLog() {
+  var log = await fetchJSON('/__openclaw__/canvas/ig-bot-log-snapshot.json');
+  var el = document.getElementById('botLog');
+  if (!log || !Array.isArray(log) || log.length === 0) {
+    el.innerHTML = '<p class="empty">No bot activity logged</p>';
+    return;
+  }
+  var recent = log.slice(-30).reverse();
+  var html = '<table><tr><th>Time</th><th>Level</th><th>Message</th></tr>';
+  for (var i = 0; i < recent.length; i++) {
+    var e = recent[i];
+    var time = e.timestamp ? new Date(e.timestamp).toLocaleString() : '?';
+    var levelAttr = e.level === 'ERROR' ? ' class="error"' : (e.level === 'TRADE' ? ' style="color:#2dc653;font-weight:600"' : '');
+    html += '<tr><td style="white-space:nowrap;font-size:12px">' + time + '</td><td' + levelAttr + '>' + e.level + '</td><td style="font-size:12px">' + e.message + '</td></tr>';
+  }
+  html += '</table>';
+  el.innerHTML = html;
+}
+
+async function loadVerifyLog() {
+  var log = await fetchJSON('/__openclaw__/canvas/ig-verify-log.json');
+  var el = document.getElementById('verifyLog');
+  if (!log || !Array.isArray(log) || log.length === 0) {
+    el.innerHTML = '<p class="empty">No trade verifications recorded</p>';
+    return;
+  }
+  var recent = log.slice(-20).reverse();
+  var html = '<table><tr><th>Time</th><th>Instrument</th><th>Direction</th><th>Size</th><th>Spread</th><th>Verdict</th><th>Details</th></tr>';
+  for (var i = 0; i < recent.length; i++) {
+    var v = recent[i];
+    var time = v.timestamp ? new Date(v.timestamp).toLocaleString() : '?';
+    var verdictClass = v.verdict === 'APPROVED' ? 'badge-on' : 'badge-alert';
+    var verdictBadge = '<span class="badge ' + verdictClass + '">' + v.verdict + '</span>';
+    var failedChecks = '';
+    if (v.checks) {
+      var failed = v.checks.filter(function(c) { return !c.pass; });
+      failedChecks = failed.length > 0 ? failed.map(function(c) { return c.check; }).join(', ') : 'All passed';
+    }
+    html += '<tr><td style="white-space:nowrap;font-size:12px">' + time + '</td>';
+    html += '<td>' + (v.name || v.instrument || '?') + '</td>';
+    html += '<td>' + (v.direction || '?') + '</td>';
+    html += '<td>' + (v.size || '?') + '</td>';
+    html += '<td>' + (v.spread != null ? v.spread.toFixed(5) : '-') + '</td>';
+    html += '<td>' + verdictBadge + '</td>';
+    html += '<td style="font-size:11px;color:#8b949e">' + failedChecks + '</td></tr>';
+  }
+  html += '</table>';
+  el.innerHTML = html;
+}
+
+async function loadSessionStatus() {
+  var data = await apiFetch('/api/ig/session');
+  var el = document.getElementById('sessionBadge');
+  if (!data) {
+    el.innerHTML = '<span class="badge badge-off">SESSION UNKNOWN</span>';
+    return;
+  }
+  if (data.status === 'connected') {
+    el.innerHTML = '<span class="badge badge-on">SESSION CONNECTED</span>';
+  } else if (data.status === 'connecting') {
+    el.innerHTML = '<span class="badge badge-spike">CONNECTING...</span>';
+  } else if (data.status === 'error') {
+    el.innerHTML = '<span class="badge badge-alert">SESSION ERROR</span>';
+  } else if (data.status === 'not_configured') {
+    el.innerHTML = '<span class="badge badge-off">NOT CONFIGURED</span>';
+  } else {
+    el.innerHTML = '<span class="badge badge-off">DISCONNECTED</span>';
+  }
+}
+
+document.getElementById('btnRefreshSession').addEventListener('click', function() {
+  var btn = this;
+  btn.textContent = 'Refreshing...';
+  btn.disabled = true;
+  var opts = { method: 'POST', headers: { 'Content-Type': 'application/json' } };
+  if (TOKEN) opts.headers['Authorization'] = 'Bearer ' + TOKEN;
+  fetch('/api/ig/session/refresh', opts).then(function(res) {
+    return res.json();
+  }).then(function() {
+    btn.textContent = 'Force Refresh Session';
+    btn.disabled = false;
+    refresh();
+  }).catch(function() {
+    btn.textContent = 'Force Refresh Session';
+    btn.disabled = false;
+    refresh();
+  });
+});
+
+document.getElementById('btnRefreshSnap').addEventListener('click', function() {
+  var btn = this;
+  btn.textContent = 'Refreshing...';
+  btn.disabled = true;
+  apiFetch('/api/ig/refresh-snapshots').then(function() {
+    btn.textContent = 'Refresh Snapshots';
+    btn.disabled = false;
+    refresh();
+  }).catch(function() {
+    btn.textContent = 'Refresh Snapshots';
+    btn.disabled = false;
+  });
+});
+
+async function loadProcessesPanel() {
+  var el = document.getElementById('processesPanel');
+  try {
+    var botsRes = await apiFetch('/api/bots');
+    var procsRes = await apiFetch('/api/processes');
+    var bots = (botsRes && botsRes.bots) ? botsRes.bots : [];
+    var procs = (procsRes && procsRes.processes) ? procsRes.processes : [];
+
+    var html = '<div style="margin-bottom:12px;font-size:12px;color:#8b949e;font-weight:600">REGISTERED BOTS</div>';
+    if (bots.length === 0) {
+      html += '<p class="empty" style="padding:8px">No bots registered</p>';
+    } else {
+      html += '<table><tr><th>ID</th><th>Status</th><th>Startup</th><th>PID</th><th>Restarts</th><th>Command</th><th>Actions</th></tr>';
+      for (var i = 0; i < bots.length; i++) {
+        var b = bots[i];
+        var badge = b.running ? '<span class="proc-badge proc-running">RUNNING</span>'
+          : (b.enabled ? '<span class="proc-badge proc-stopped">STOPPED</span>' : '<span class="proc-badge proc-disabled">DISABLED</span>');
+        var checked = b.enabled ? ' checked' : '';
+        html += '<tr>';
+        html += '<td style="font-weight:600;color:#e6edf3">' + b.id + '</td>';
+        html += '<td>' + badge + '</td>';
+        html += '<td><input type="checkbox" class="startup-check" data-proc-startup="' + b.id + '"' + checked + '> <span style="font-size:10px;color:#8b949e">Auto</span></td>';
+        html += '<td style="font-family:monospace;font-size:11px">' + (b.pid || '-') + '</td>';
+        html += '<td>' + (b.restarts || 0) + '</td>';
+        html += '<td><span class="proc-cmd" title="' + (b.cmd || '').replace(/"/g, '&quot;') + '">' + (b.cmd || '') + '</span></td>';
+        html += '<td><div class="proc-actions">';
+        if (b.running) {
+          html += '<button class="proc-btn proc-btn-stop" data-proc-bot="' + b.id + '" data-proc-action="stop">Stop</button>';
+        } else {
+          html += '<button class="proc-btn proc-btn-start" data-proc-bot="' + b.id + '" data-proc-action="start">Start</button>';
+        }
+        html += '<button class="proc-btn proc-btn-remove" data-proc-bot="' + b.id + '" data-proc-action="remove">Remove</button>';
+        html += '</div></td>';
+        html += '</tr>';
+      }
+      html += '</table>';
+    }
+
+    html += '<div style="margin:16px 0 12px;font-size:12px;color:#8b949e;font-weight:600">AD-HOC PROCESSES <span style="font-weight:400">(' + procs.length + ')</span></div>';
+    if (procs.length === 0) {
+      html += '<p class="empty" style="padding:8px">No ad-hoc scripts running</p>';
+    } else {
+      html += '<table><tr><th>Name</th><th>Type</th><th>PID</th><th>CPU</th><th>MEM</th><th>Command</th><th></th></tr>';
+      for (var j = 0; j < procs.length; j++) {
+        var p = procs[j];
+        var typeBadge = p.type === 'bot' ? 'proc-running' : (p.type === 'monitor' ? 'proc-stopped' : 'proc-disabled');
+        html += '<tr>';
+        html += '<td style="font-weight:600;color:#e6edf3">' + p.name + '</td>';
+        html += '<td><span class="proc-badge ' + typeBadge + '">' + p.type + '</span></td>';
+        html += '<td style="font-family:monospace;font-size:11px">' + p.pid + '</td>';
+        html += '<td>' + p.cpu + '%</td>';
+        html += '<td>' + p.mem + '%</td>';
+        html += '<td><span class="proc-cmd" title="' + p.cmd.replace(/"/g, '&quot;') + '">' + p.cmd + '</span></td>';
+        html += '<td><button class="proc-btn proc-btn-kill" data-proc-kill="' + p.pid + '" data-proc-name="' + p.name.replace(/"/g, '&quot;') + '">Kill</button></td>';
+        html += '</tr>';
+      }
+      html += '</table>';
+    }
+
+    el.innerHTML = html;
+  } catch (e) {
+    el.innerHTML = '<p class="empty" style="color:#f85149">Error: ' + e.message + '</p>';
+  }
+}
+
+document.getElementById('processesPanel').addEventListener('click', async function(e) {
+  var botBtn = e.target.closest('[data-proc-bot]');
+  if (botBtn) {
+    var id = botBtn.getAttribute('data-proc-bot');
+    var action = botBtn.getAttribute('data-proc-action');
+    if (action === 'remove' && !confirm('Remove bot "' + id + '" from registry?')) return;
+    if (action === 'start' || action === 'stop') {
+      var res = await apiPost('/api/bots/' + encodeURIComponent(id) + '/' + action);
+      showToast(res ? (action === 'start' ? 'Started: ' : 'Stopped: ') + id : 'Failed', !!res);
+    } else if (action === 'remove') {
+      var dres = await apiDelete('/api/bots/' + encodeURIComponent(id));
+      showToast(dres && !dres._httpError ? 'Removed: ' + id : 'Failed to remove', !!(dres && !dres._httpError));
+    }
+    setTimeout(loadProcessesPanel, 1000);
+    return;
+  }
+  var killBtn = e.target.closest('[data-proc-kill]');
+  if (killBtn) {
+    var pid = parseInt(killBtn.getAttribute('data-proc-kill'));
+    var name = killBtn.getAttribute('data-proc-name');
+    if (!confirm('Kill process "' + name + '" (PID ' + pid + ')?')) return;
+    var kres = await apiPost('/api/processes/kill', { pid: pid });
+    showToast(kres ? 'Killed: ' + name : 'Failed to kill', !!kres);
+    setTimeout(loadProcessesPanel, 1000);
+  }
+});
+
+document.getElementById('processesPanel').addEventListener('change', async function(e) {
+  var cb = e.target.closest('[data-proc-startup]');
+  if (!cb) return;
+  var id = cb.getAttribute('data-proc-startup');
+  try {
+    var res = await fetch('/api/bots/' + encodeURIComponent(id), {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + TOKEN },
+      body: JSON.stringify({ enabled: cb.checked })
+    });
+    var data = await res.json();
+    if (res.ok) {
+      showToast(id + ': Auto-start ' + (cb.checked ? 'ON' : 'OFF'), true);
+    } else {
+      showToast('Error: ' + (data.error || 'Failed'), false);
+      setTimeout(loadProcessesPanel, 500);
+    }
+  } catch (err) {
+    showToast('Error: ' + err.message, false);
+    setTimeout(loadProcessesPanel, 500);
+  }
+});
+
+async function refresh() {
+  document.getElementById('lastUpdate').textContent = new Date().toLocaleString();
+  await loadStrategy();
+  await Promise.all([loadAccount(), loadPositions(), updateLivePrices(), loadWatchlist(), loadProofread(), loadAlerts(), loadVerifyLog(), loadBotLog(), loadSessionStatus(), loadProcessesPanel()]);
+}
+
+renderTimeframeTabs(currentTimeframe);
+refresh();
+setInterval(function() { updateLivePrices(); }, 5000);
+setInterval(function() {
+  if (selectedEpic) loadMarketData(selectedEpic);
+}, 10000);
+setInterval(function() { refresh(); }, 30000);
+</script>
+</body>
+</html>
