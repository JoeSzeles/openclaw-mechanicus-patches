+  document.getElementById('available').textContent = b.available != null ? b.available.toFixed(2) : '--';
+  var pnlVal = b.profitLoss != null ? b.profitLoss : 0;
+  var pnlEl = document.getElementById('pnl');
+  pnlEl.textContent = (pnlVal >= 0 ? '+' : '') + pnlVal.toFixed(2);
