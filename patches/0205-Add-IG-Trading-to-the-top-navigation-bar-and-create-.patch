+    resultsEl.innerHTML = '<p class="empty">No results for "' + q + '"</p>';
+    return;
+  }
+
+  var markets = data.markets;
+  var html = '';
+  for (var i = 0; i < markets.length && i < 30; i++) {
+    var m = markets[i];
+    var already = watchedInstruments.some(function(w) { return w.epic === m.epic; });
+    var statusBadge = m.marketStatus === 'TRADEABLE' ?
+      '<span class="badge badge-on">' + m.marketStatus + '</span>' :
+      '<span class="badge badge-off">' + (m.marketStatus || 'CLOSED') + '</span>';
