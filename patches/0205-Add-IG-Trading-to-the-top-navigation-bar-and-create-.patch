+    var inst = watchedInstruments[i];
+    var isActive = selectedEpic === inst.epic;
+    var price = livePrices[inst.epic];
+    var statusClass = price && price.marketState === 'TRADEABLE' ? 'open' : 'closed';
+    var priceStr = price ? fmtNum(price.mid || ((price.bid + price.offer) / 2), 1) : '';
+    var changeStr = '';
+    if (price && price.percentageChange != null) {
+      var pct = price.percentageChange;
+      changeStr = '<span class="' + (pct >= 0 ? 'pos' : 'neg') + '" style="font-size:11px">' + (pct >= 0 ? '+' : '') + fmtNum(pct, 2) + '%</span>';
