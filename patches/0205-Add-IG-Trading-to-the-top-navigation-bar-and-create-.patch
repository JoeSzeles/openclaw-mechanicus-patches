+
+function updateDealPanel(marketData) {
+  var panel = document.getElementById('dealPanel');
+  panel.style.display = 'block';
+  var snap = marketData.snapshot || {};
+  var inst = marketData.instrument || {};
+  var deal = marketData.dealingRules || {};
+
+  var bid = snap.bid || 0;
+  var offer = snap.offer || 0;
+  var spread = (offer - bid).toFixed(1);
+
+  var minSize = 0.01;
+  if (deal.minDealSize && deal.minDealSize.value) minSize = deal.minDealSize.value;
+  var minStop = '';
+  if (deal.minNormalStopOrLimitDistance && deal.minNormalStopOrLimitDistance.value) {
+    minStop = deal.minNormalStopOrLimitDistance.value;
+  }
+
+  document.getElementById('dealPrices').innerHTML =
+    '<button class="deal-btn sell' + (dealDirection === 'SELL' ? ' selected' : '') + '" onclick="setDealDirection(\'SELL\')">' +
+      '<span class="deal-label">SELL</span><span class="deal-price">' + fmtNum(bid, 1) + '</span>' +
+    '</button>' +
+    '<button class="deal-btn buy' + (dealDirection === 'BUY' ? ' selected' : '') + '" onclick="setDealDirection(\'BUY\')">' +
+      '<span class="deal-label">BUY</span><span class="deal-price">' + fmtNum(offer, 1) + '</span>' +
+    '</button>';
+  document.getElementById('dealSpread').textContent = spread;
+
+  document.getElementById('orderPrices').innerHTML =
+    '<button class="deal-btn sell' + (dealDirection === 'SELL' ? ' selected' : '') + '" onclick="setDealDirection(\'SELL\')">' +
+      '<span class="deal-label">SELL</span><span class="deal-price">' + fmtNum(bid, 1) + '</span>' +
+    '</button>' +
+    '<button class="deal-btn buy' + (dealDirection === 'BUY' ? ' selected' : '') + '" onclick="setDealDirection(\'BUY\')">' +
+      '<span class="deal-label">BUY</span><span class="deal-price">' + fmtNum(offer, 1) + '</span>' +
+    '</button>';
+  document.getElementById('orderSpread').textContent = spread;
+
+  document.getElementById('dealSizeInfo').textContent = 'contracts' + (minSize ? ' min: ' + minSize : '');
+  if (minStop) {
+    document.getElementById('dealStop').placeholder = 'min: ' + minStop;
+    document.getElementById('orderStop').placeholder = 'min: ' + minStop;
+    document.getElementById('dealStopSuffix').textContent = 'pts away  min: ' + minStop;
+  }
+
+  var submitBtn = document.getElementById('dealSubmit');
+  submitBtn.className = 'deal-submit ' + (dealDirection === 'BUY' ? 'buy-mode' : 'sell-mode');
+  submitBtn.textContent = 'Place deal';
+
+  var orderSubmitBtn = document.getElementById('orderSubmit');
+  orderSubmitBtn.className = 'deal-submit ' + (dealDirection === 'BUY' ? 'buy-mode' : 'sell-mode');
+  orderSubmitBtn.textContent = 'Place order';
+
+  var infoEl = document.getElementById('marketInfoContent');
+  var infoHtml = '<table>';
+  infoHtml += '<tr><td class="mi-label">Minimum size</td><td class="mi-value">' + minSize + '</td></tr>';
+  if (inst.contractSize) infoHtml += '<tr><td class="mi-label">Contract size per point</td><td class="mi-value">' + inst.contractSize + '</td></tr>';
+  if (inst.onePipMeans) infoHtml += '<tr><td class="mi-label">One point means</td><td class="mi-value">' + inst.onePipMeans + '</td></tr>';
+  if (inst.valueOfOnePip) infoHtml += '<tr><td class="mi-label">Value of one point</td><td class="mi-value">' + inst.valueOfOnePip + '</td></tr>';
+  if (minStop) infoHtml += '<tr><td class="mi-label">Minimum stop distance</td><td class="mi-value">' + minStop + '</td></tr>';
+  if (inst.slippageFactor && inst.slippageFactor.value) infoHtml += '<tr><td class="mi-label">Slippage factor</td><td class="mi-value">' + (inst.slippageFactor.value * 100) + '%</td></tr>';
+  if (inst.marginFactor) infoHtml += '<tr><td class="mi-label">Margin factor</td><td class="mi-value">' + inst.marginFactor + '%</td></tr>';
+  if (inst.currencies) {
