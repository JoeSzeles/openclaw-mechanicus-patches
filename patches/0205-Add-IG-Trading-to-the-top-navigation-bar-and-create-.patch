+    if (priceStr) html += ' <span style="font-size:12px;color:#c9d1d9">' + priceStr + '</span>';
+    if (changeStr) html += ' ' + changeStr;
+    html += '<span class="wl-close" onclick="event.stopPropagation();removeInstrument(' + i + ')" title="Remove">&times;</span>';
+    html += '</button>';
