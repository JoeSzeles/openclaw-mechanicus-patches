+async function placeDeal() {
+  if (!selectedEpic) { showToast('No instrument selected', false); return; }
+  var btn = document.getElementById('dealSubmit');
+  btn.disabled = true;
+  btn.textContent = 'Placing...';
+
+  var stop = document.getElementById('dealStop').value;
+  var limit = document.getElementById('dealLimit').value;
+  var hasStopLimit = (stop && parseFloat(stop) > 0) || (limit && parseFloat(limit) > 0);
+
+  var forceOpenRadio = document.querySelector('input[name="dealNetOff"]:checked');
+  var forceOpen = forceOpenRadio ? forceOpenRadio.value === 'true' : false;
+  if (hasStopLimit) forceOpen = true;
+
+  var dealCurrency = 'AUD';
+  if (selectedMarketData && selectedMarketData.instrument && selectedMarketData.instrument.currencies) {
+    var currs = selectedMarketData.instrument.currencies;
+    if (currs.length > 0) dealCurrency = currs[0].code;
+  }
+
+  var body = {
+    epic: selectedEpic,
+    direction: dealDirection,
+    size: parseFloat(document.getElementById('dealSize').value),
+    orderType: 'MARKET',
+    currencyCode: dealCurrency,
+    forceOpen: forceOpen
+  };
+
+  if (stop && parseFloat(stop) > 0) body.stopDistance = parseFloat(stop);
+  if (limit && parseFloat(limit) > 0) body.limitDistance = parseFloat(limit);
+
+  var result = await apiPost('/api/ig/positions/open', body);
+  btn.disabled = false;
+  btn.textContent = 'Place deal';
+
+  var conf = result && result.confirmation ? result.confirmation : result;
+  if (conf && conf.dealStatus === 'ACCEPTED') {
+    showToast('Deal placed: ' + dealDirection + ' ' + body.size + ' ' + selectedEpic, true);
+    setTimeout(function() { loadPositions(); loadAccount(); }, 1500);
+  } else if (conf && conf.dealStatus === 'REJECTED') {
+    showToast('Deal rejected: ' + (conf.reason || 'unknown'), false);
+  } else if (result && result.error) {
+    showToast('Error: ' + result.error, false);
+  } else {
+    showToast('Deal may have been placed — check positions', false);
+  }
+}
+
+async function placeOrder() {
+  if (!selectedEpic) { showToast('No instrument selected', false); return; }
+  var btn = document.getElementById('orderSubmit');
+  btn.disabled = true;
+  btn.textContent = 'Placing...';
+
+  var priceLevel = parseFloat(document.getElementById('orderPriceLevel').value);
+  if (!priceLevel || isNaN(priceLevel)) {
+    showToast('Price level required for limit/stop orders', false);
+    btn.disabled = false;
+    btn.textContent = 'Place order';
+    return;
+  }
+
+  var snap = selectedMarketData && selectedMarketData.snapshot ? selectedMarketData.snapshot : {};
+  var mid = ((snap.bid || 0) + (snap.offer || 0)) / 2;
+  var orderType;
+  if (dealDirection === 'BUY') {
+    orderType = priceLevel < mid ? 'LIMIT' : 'STOP';
+  } else {
+    orderType = priceLevel > mid ? 'LIMIT' : 'STOP';
+  }
+
+  var orderCurrency = 'AUD';
+  if (selectedMarketData && selectedMarketData.instrument && selectedMarketData.instrument.currencies) {
+    var currs = selectedMarketData.instrument.currencies;
+    if (currs.length > 0) orderCurrency = currs[0].code;
+  }
+
+  var body = {
+    epic: selectedEpic,
+    direction: dealDirection,
+    size: parseFloat(document.getElementById('orderSize').value),
+    level: priceLevel,
+    type: orderType,
+    currencyCode: orderCurrency,
+    expiry: document.getElementById('orderExpiry').value === 'DFB' ? 'DFB' : '-',
+    guaranteedStop: false,
+    forceOpen: true
+  };
+
+  var stop = document.getElementById('orderStop').value;
+  if (stop && parseFloat(stop) > 0) body.stopDistance = parseFloat(stop);
+  var limit = document.getElementById('orderLimit').value;
+  if (limit && parseFloat(limit) > 0) body.limitDistance = parseFloat(limit);
+
+  var result = await apiPost('/api/ig/workingorders/create', body);
+  btn.disabled = false;
+  btn.textContent = 'Place order';
+
+  var conf = result && result.confirmation ? result.confirmation : result;
+  if (conf && conf.dealStatus === 'ACCEPTED') {
+    showToast('Order placed: ' + orderType + ' ' + dealDirection + ' @ ' + priceLevel, true);
+  } else if (conf && conf.dealStatus === 'REJECTED') {
+    showToast('Order rejected: ' + (conf.reason || 'unknown'), false);
+  } else if (result && result.error) {
+    showToast('Error: ' + result.error, false);
+  } else {
+    showToast('Order may have been placed — check working orders', false);
+  }
+}
+
+async function loadChart(epic, resolution) {
+  var emptyEl = document.getElementById('chartEmpty');
+  var canvas = document.getElementById('priceChart');
+
+  renderTimeframeTabs(resolution);
+
+  if (!epic) {
+    emptyEl.style.display = 'block';
+    canvas.style.display = 'none';
+    return;
+  }
+
+  emptyEl.style.display = 'none';
+  emptyEl.textContent = 'Loading chart...';
+  emptyEl.style.display = 'block';
+  canvas.style.display = 'none';
+
+  var maxPoints = 100;
+  if (resolution === 'MINUTE') maxPoints = 120;
+  if (resolution === 'MINUTE_5') maxPoints = 120;
+  if (resolution === 'MINUTE_15') maxPoints = 100;
+  if (resolution === 'HOUR_4') maxPoints = 80;
+  if (resolution === 'DAY') maxPoints = 60;
+  if (resolution === 'WEEK') maxPoints = 52;
+
+  var data = await apiFetch('/api/ig/pricehistory/' + epic + '?resolution=' + resolution + '&max=' + maxPoints);
+  if (!data || !data.prices || data.prices.length === 0) {
+    emptyEl.textContent = 'No price history for this timeframe';
+    return;
+  }
+
+  emptyEl.style.display = 'none';
+  canvas.style.display = 'block';
+
+  var prices = data.prices;
+  var labels = [];
+  var opens = [];
+  var highs = [];
+  var lows = [];
+  var closes = [];
+  var mids = [];
+
+  for (var i = 0; i < prices.length; i++) {
+    var p = prices[i];
+    var dt = new Date(p.snapshotTime || p.snapshotTimeUTC);
+    if (resolution === 'DAY' || resolution === 'WEEK') {
+      labels.push(dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }));
+    } else if (resolution === 'HOUR' || resolution === 'HOUR_4') {
+      labels.push(dt.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) + ' ' + dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }));
+    } else {
+      labels.push(dt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }));
+    }
+    var cm = p.closePrice || {};
+    var om = p.openPrice || {};
+    var hm = p.highPrice || {};
+    var lm = p.lowPrice || {};
+    var midClose = ((cm.bid || 0) + (cm.ask || 0)) / 2;
+    var midOpen = ((om.bid || 0) + (om.ask || 0)) / 2;
+    var midHigh = ((hm.bid || 0) + (hm.ask || 0)) / 2;
+    var midLow = ((lm.bid || 0) + (lm.ask || 0)) / 2;
+    opens.push(midOpen);
+    highs.push(midHigh);
+    lows.push(midLow);
+    closes.push(midClose);
+    mids.push(midClose);
+  }
+
+  if (priceChart) priceChart.destroy();
+
+  var ctx = canvas.getContext('2d');
+  priceChart = new Chart(ctx, {
+    type: 'line',
+    data: {
+      labels: labels,
+      datasets: [
+        {
+          label: 'Close',
+          data: closes,
+          borderColor: '#58a6ff',
+          backgroundColor: 'rgba(88,166,255,0.08)',
+          borderWidth: 2,
+          pointRadius: 0,
+          pointHoverRadius: 4,
+          fill: true,
+          tension: 0.2
+        },
+        {
+          label: 'High',
+          data: highs,
+          borderColor: 'rgba(45,198,83,0.4)',
+          borderWidth: 1,
+          pointRadius: 0,
+          fill: false,
+          borderDash: [3, 3],
+          tension: 0.2
+        },
+        {
+          label: 'Low',
+          data: lows,
+          borderColor: 'rgba(248,81,73,0.4)',
+          borderWidth: 1,
+          pointRadius: 0,
+          fill: false,
+          borderDash: [3, 3],
+          tension: 0.2
+        }
+      ]
+    },
+    options: {
+      responsive: true,
+      maintainAspectRatio: false,
+      interaction: { mode: 'index', intersect: false },
+      plugins: {
+        legend: { labels: { color: '#8b949e', font: { size: 11 } } },
+        tooltip: {
+          backgroundColor: '#161b22',
+          borderColor: '#30363d',
+          borderWidth: 1,
+          titleColor: '#c9d1d9',
+          bodyColor: '#8b949e',
+          callbacks: {
+            label: function(ctx) {
+              return ctx.dataset.label + ': ' + fmtNum(ctx.parsed.y, 2);
+            }
+          }
+        },
+        zoom: {
+          pan: {
+            enabled: true,
+            mode: 'x'
+          },
+          zoom: {
+            wheel: { enabled: true },
+            pinch: { enabled: true },
+            mode: 'x'
+          }
+        }
+      },
+      scales: {
+        x: {
+          ticks: { color: '#484f58', maxTicksLimit: 12, font: { size: 10 }, maxRotation: 45, minRotation: 0 },
+          grid: { color: 'rgba(48,54,61,0.5)' }
+        },
+        y: {
+          ticks: { color: '#484f58', font: { size: 10 } },
+          grid: { color: 'rgba(48,54,61,0.5)' }
+        }
+      }
+    }
+  });
+}
+
+function renderTimeframeTabs(activeResolution) {
+  var el = document.getElementById('timeframeTabs');
+  var html = '';
+  for (var i = 0; i < TIMEFRAMES.length; i++) {
+    var tf = TIMEFRAMES[i];
+    html += '<button class="tf-tab' + (tf.key === activeResolution ? ' active' : '') + '" onclick="changeTimeframe(\'' + tf.key + '\')">' + tf.label + '</button>';
+  }
+  html += '<button class="tf-tab" onclick="resetChartZoom()" title="Reset zoom" style="margin-left:8px">Reset</button>';
+  el.innerHTML = html;
+}
+
+function changeTimeframe(tf) {
+  currentTimeframe = tf;
+  if (selectedEpic) loadChart(selectedEpic, tf);
+}
+
+function resetChartZoom() {
+  if (priceChart) priceChart.resetZoom();
+}
+
+function openSearch() {
+  var overlay = document.getElementById('searchOverlay');
+  overlay.classList.add('visible');
+  var input = document.getElementById('searchInput');
